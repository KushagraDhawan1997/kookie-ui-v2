{
  "name": "docs",
  "private": true,
  "type": "module",
  "description": "KookieUI docs. Bare Next.js as the rendering substrate; every visible pixel is @kushagradhawan/kookie-ui-react. No docs framework and no third-party UI — a design system whose docs are built on someone else's system argues against itself (decided 2026-08-05, Kushagra; LOG). Icons are the exception the package itself names: §8 ships no icon dependency because icons are ReactNode slots the APP fills, so the app fills them with Hugeicons (2026-08-10).",
  "scripts": {
    "dev": "next dev --port 1403",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app blocks examples mdx-components.tsx mdx-plugins middleware.ts next.config.ts scripts && tsc -p tsconfig.json",
    "test": "vitest run",
    "api": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-api.ts",
    "api:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-api.ts --check",
    "agents": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-agents.ts",
    "agents:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-agents.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@kushagradhawan/kookie-ui-react": "workspace:*",
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@shikijs/transformers": "^4.4.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
