{
  "permissions": {
    "allow": [
      "Bash(pnpm run ci)",
      "Bash(pnpm run ci *)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run build)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run measure)",
      "Bash(pnpm run measure *)",
      "Bash(pnpm run tokens)",
      "Bash(pnpm run tokens *)",
      "Bash(pnpm run preview)",
      "Bash(pnpm run preview *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run test *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run lint *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run build *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run measure *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run tokens *)",
      "Bash(pnpm --filter @kushagradhawan/kookie-ui-react run preview *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm vitest run *)",
      "Bash(node scripts/measure-css.mjs)",
      "Bash(open packages/ui/preview/density.html)",
      "Bash(open preview/density.html)",
      "Bash(open http://localhost:*)",
      "Bash(node scripts/review-ui/run.mjs *)",
      "Bash(node --test scripts/review-ui/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-checks.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-before-stop.mjs\""
          }
        ]
      }
    ]
  }
}
